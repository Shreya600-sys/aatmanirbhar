# Server port (hosting platforms like Render set this automatically)
PORT=8080

# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGO_URI=your_mongodb_connection_string

# Any long random text. Keep it secret.
JWT_SECRET=change_this_to_a_long_random_string
# How long a login lasts
JWT_EXPIRE=7d

# Optional: your frontend URL (no trailing slash). If set, only this site can call the API.
# Leave empty to allow any site. Several URLs can be separated with commas.
CLIENT_URL=http://localhost:5173
